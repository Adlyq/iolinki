FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    clang \
    cmake \
    build-essential \
    libcmocka-dev \
    cppcheck \
    pkg-config \
    git \
    python3 \
    python3-pip \
    nodejs \
    doxygen \
    graphviz \
    valgrind \
    libc6-dbg \
    xz-utils \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Arm Toolchain for Embedded: the compiler the ROM/RAM baseline is measured
# with (tools/size_matrix.py defaults to it). Arm publishes no container image,
# only these checksummed release tarballs, so the version and the digest are
# pinned here.
ARG ATFE_VERSION=22.1.0
ARG ATFE_SHA256=e2e9e637bba097ba6e4bae6982883fe705ffd7e8c3a7dc876964835ef1c7a724
RUN mkdir -p /opt/arm-toolchain && \
    url="https://github.com/arm/arm-toolchain/releases/download/release-${ATFE_VERSION}-ATfE/ATfE-${ATFE_VERSION}-Linux-x86_64.tar.xz" && \
    wget -q -O /tmp/atfe.tar.xz "$url" && \
    echo "${ATFE_SHA256}  /tmp/atfe.tar.xz" | sha256sum -c - && \
    tar xf /tmp/atfe.tar.xz -C /opt/arm-toolchain --strip-components=1 && \
    rm /tmp/atfe.tar.xz
ENV ARM_ATFE=/opt/atfe/bin

# Pinned to match .pre-commit-config.yaml; tools/gates.sh enforces this version.
RUN pip3 install --no-cache-dir clang-format==23.1.1

# Install Python Virtual Master dependencies
COPY tools/virtual_master/requirements.txt /tmp/
RUN pip3 install -r /tmp/requirements.txt

WORKDIR /workspace

# Copy source code
COPY . .

# Build and test
CMD ["bash", "-c", "rm -rf build && cmake -B build -DIOLINK_PLATFORM=LINUX && cmake --build build && \
    cd build && ctest --output-on-failure && cd .. && \
    export IOLINK_DEVICE_PATH=/workspace/build/examples/host_demo/host_demo && \
    python3 tools/virtual_master/test_automated_mandatory.py && \
    python3 tools/virtual_master/test_pd_variable.py && \
    python3 tools/virtual_master/test_baudrate.py"]
